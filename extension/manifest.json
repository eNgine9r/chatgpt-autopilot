{
  "manifest_version": 3,
  "name": "ChatGPT Project Autopilot",
  "version": "0.2.0",
  "description": "Local per-chat continuation and USER_ACTION_REQUIRED safety gate.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["policy.js", "message-extractor.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
