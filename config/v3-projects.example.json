{
  "version": 3,
  "projects": [
    {
      "id": "btc-radar-development",
      "enabled": true,
      "repoPath": "/srv/btc-radar",
      "github": { "repository": "eNgine9r/btc-radar-telegram", "taskLabels": ["autopilot"] },
      "tests": {
        "required": { "command": "python3", "args": ["-m", "pytest", "-q"], "timeoutMs": 900000 }
      },
      "steps": [
        { "id": "inspect", "action": "repo.inspect" },
        { "id": "test", "action": "repo.test", "params": { "alias": "required" } },
        { "id": "review", "action": "operator.review", "approval": "user" }
      ]
    },
    {
      "id": "nexolab-development",
      "enabled": true,
      "transport": {
        "type": "ssh-gateway",
        "host": "nexolab-edge-01",
        "user": "nexolab",
        "identityFile": "/home/btcradar/.ssh/autopilot-v3-nexolab"
      },
      "github": { "repository": "eNgine9r/nexolab-platform", "taskLabels": ["autopilot"] },
      "tests": {
        "required": { "remote": true, "timeoutMs": 900000 }
      },
      "steps": [
        { "id": "inspect", "action": "repo.inspect" },
        { "id": "test", "action": "repo.test", "params": { "alias": "required" } },
        { "id": "review", "action": "operator.review", "approval": "user" }
      ],
      "commander": {
        "enabled": false,
        "deviceId": "nexolab-edge-01",
        "repoPath": "/home/nexolab/nexolab-platform",
        "testAliases": { "required": "v3-required" }
      }
    }
  ]
}
