{
  "version": 3,
  "projects": [
    {
      "id": "btc-radar-development",
      "enabled": true,
      "repoPath": "/srv/btc-radar",
      "tests": {
        "required": { "command": "python3", "args": ["-m", "pytest", "-q"], "timeoutMs": 900000 }
      },
      "steps": [
        { "id": "inspect", "action": "repo.inspect" },
        { "id": "test", "action": "repo.test", "params": { "alias": "required" } },
        { "id": "review", "action": "operator.review", "approval": "user" }
      ]
    },
    {
      "id": "nexolab-development",
      "enabled": true,
      "repoPath": "/srv/nexolab",
      "tests": {
        "required": { "command": "npm", "args": ["test"], "timeoutMs": 900000 }
      },
      "steps": [
        { "id": "inspect", "action": "repo.inspect" },
        { "id": "test", "action": "repo.test", "params": { "alias": "required" } },
        { "id": "review", "action": "operator.review", "approval": "user" }
      ]
    }
  ]
}
