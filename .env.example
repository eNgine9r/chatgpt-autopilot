# Host Chromium. Use an already-installed ordinary Chromium binary.
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Local graphical session used by the Raspberry Pi desktop.
DISPLAY=:0
XAUTHORITY=/home/pi/.Xauthority
XDG_RUNTIME_DIR=/run/user/1000
WAYLAND_DISPLAY=wayland-0
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
CHROMIUM_OZONE_PLATFORM=wayland

# Raspberry Pi Connect startup gate. Chromium waits for idle screen sharing.
RPI_CONNECT_EXECUTABLE_PATH=/usr/bin/rpi-connect
CONNECT_PREFLIGHT_POLL_SECONDS=2
CONNECT_PREFLIGHT_TIMEOUT_SECONDS=180

# Chromium can trigger a GCR/keyring prompt that blocks all browser automation.
# Autopilot continuously dismisses same-user prompts while its Chromium is running.
KEYRING_PROMPT_AUTO_CANCEL=true
KEYRING_PROMPT_POLL_MS=250
KEYRING_PROMPT_WATCH_SECONDS=0

# Delay between opening heavy ChatGPT project tabs at startup.
PROJECT_STARTUP_STAGGER_SECONDS=60

# Optional Telegram alerts. Keep real values only in local .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Private local runtime paths.
BROWSER_PROFILE_DIR=./browser-profile
LOG_DIR=./logs
STATE_DIR=./state
PROJECTS_FILE=./config/projects.json

# Independent no-progress watchdog poll interval
SUPERVISOR_WATCHDOG_POLL_SECONDS=30
