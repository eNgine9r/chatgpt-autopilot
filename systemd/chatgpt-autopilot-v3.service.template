[Unit]
Description=ChatGPT Autopilot v3 Deterministic Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
ExecStart=__NODE_BIN__ __REPO_DIR__/src/v3/index.mjs --config __REPO_DIR__/config/v3-projects.json --state-dir __REPO_DIR__/state-v3
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
