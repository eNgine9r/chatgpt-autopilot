[Unit]
Description=ChatGPT Autopilot v3 Telegram Bridge
After=network-online.target chatgpt-autopilot-v3.service
Wants=network-online.target
Requires=chatgpt-autopilot-v3.service

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
ExecStart=__NODE_BIN__ __REPO_DIR__/src/v3/telegram-service.mjs --env __REPO_DIR__/.env --config __REPO_DIR__/config/v3-projects.json --state-file __REPO_DIR__/state-v3/telegram.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
