[Unit]
Description=Standalone ChatGPT Project Autopilot

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
Environment=HOME=__HOME__
Environment=NODE_ENV=production
ExecStart=__NODE__ __APP_DIR__/src/index.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=default.target
